pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {HazMatAnchor} from "./HazMatAnchor.sol";

/// Vector generated by matcher/hazmat/anchor.py over five synthetic leaves, so the
/// Solidity folder and the Python prover check each other rather than each being
/// trusted alone. Two levels are odd, which exercises duplicate-the-last.
contract HazMatAnchorTest is Test {
    HazMatAnchor anchorContract;
    bytes32 constant ROOT = bytes32(0x64263ec54e118a1a257632f7bb448c813b4e36ca5be8c9eb0733a8d2eba08db0);
    bytes32 constant LEAF = bytes32(0x10a9efebd232336dd0f7ce1952e6b764c03ab6fc7f81abd938fe95db2a31aaae);
    bytes32 constant STRANGER = bytes32(0xf62b197572cd131d4624c9caeaa7711aecad967ea466e508eb9cbb0683247a0c);

    function setUp() public { anchorContract = new HazMatAnchor(); }

    function proof() internal pure returns (bytes32[] memory p) {
        p = new bytes32[](3);
        p[0] = bytes32(0x0c165b804a4294c8f1b189940bb8b69b41a807ec46741112fd60df7dd62c8ea1);
        p[1] = bytes32(0x6732b2f031f491772246a0f8baa45c76f8aa3879e77e6a04adebe9090bcbf402);
        p[2] = bytes32(0x3d84523ed9fbb1b09b63f6144f20cd50e30994bd822652db91adbbe6a2b976ae);
    }

    function test_a_member_leaf_verifies_against_the_published_root() public {
        anchorContract.anchor(1, ROOT, "0xdeadbeefdeadbeef");
        assertTrue(anchorContract.verify(LEAF, proof(), 1));
        assertEq(anchorContract.fold(LEAF, proof()), ROOT);
    }

    function test_a_tampered_leaf_does_not_verify() public {
        anchorContract.anchor(1, ROOT, "0xdeadbeefdeadbeef");
        assertFalse(anchorContract.verify(STRANGER, proof(), 1));
    }

    function test_an_unpublished_epoch_verifies_nothing() public {
        assertFalse(anchorContract.verify(LEAF, proof(), 7));
    }

    function test_the_first_root_for_an_epoch_wins() public {
        anchorContract.anchor(1, ROOT, "digest");
        vm.expectRevert(abi.encodeWithSelector(HazMatAnchor.AlreadyAnchored.selector, 1));
        anchorContract.anchor(1, bytes32(uint256(1)), "other");
        assertEq(anchorContract.roots(1), ROOT);
    }

    function test_an_empty_root_is_refused() public {
        vm.expectRevert(HazMatAnchor.EmptyRoot.selector);
        anchorContract.anchor(2, bytes32(0), "digest");
    }
}
